# Web API on Lambda: the FastAPI app as it runs locally, behind a function URL (infra/terraform/api.tf).
#
# docker build -f Dockerfile.api --platform linux/amd64 --provenance=false -t callsearch-api:v2 .
#
# The AWS Lambda Web Adapter turns each function URL request into an HTTP request to uvicorn, so
# the app needs no Lambda code. The build context comes from Dockerfile.api.dockerignore (an
# allow-list): the model, the redacted calls, the index, results and cached replies. Never raw data.

# --- Stage 1: export the query embedder to ONNX (torch is needed here, not at run time).
# Loading torch on a cold Lambda took ~85 s, past the 120 s limit with a query on top.
FROM public.ecr.aws/docker/library/python:3.12-slim AS onnx
# onnxruntime: the export is checked by running it, as the API will (same version chromadb installs).
RUN pip install --no-cache-dir torch==2.15.0 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir sentence-transformers==6.2.0 transformers==5.22.1 onnx==1.23.2 onnxscript==0.7.2 \
    onnxruntime==1.32.0
WORKDIR /build
COPY src ./src
COPY scripts/export_onnx.py ./scripts/export_onnx.py
# Fails the build if the export differs from sentence-transformers.
RUN python scripts/export_onnx.py --model bge-small --out /onnx/bge-small

# --- Stage 2: the API, without torch.
FROM public.ecr.aws/docker/library/python:3.12-slim

COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1 /lambda-adapter /opt/extensions/lambda-adapter

COPY requirements-api.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir -r /tmp/requirements-api.txt

COPY --from=onnx /onnx /opt/onnx

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps . && rm -rf build src/*.egg-info

COPY data/redacted ./data/redacted
COPY data/index ./data/index
COPY results ./results
COPY .cache ./.cache
COPY docker/api-start.sh ./start.sh

# Lambda's disk is read-only except /tmp; start.sh copies what the app writes to /tmp/app.
ENV HOME=/tmp \
    CALLSEARCH_ONNX_DIR=/opt/onnx/bge-small \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CALLSEARCH_UPLOADS=off \
    AWS_LWA_PORT=8080 \
    AWS_LWA_READINESS_CHECK_PATH=/api/health \
    AWS_LWA_ASYNC_INIT=true

CMD ["sh", "/app/start.sh"]
