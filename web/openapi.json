          },
          "elapsed_ms": {
            "title": "Elapsed Ms",
            "type": "integer"
          },
          "found": {
            "title": "Found",
            "type": "boolean"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "rejected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why a model reply was discarded, if it was",
            "title": "Rejected"
          },
          "retrieved": {
            "description": "Matched chunk ids in rank order",
            "items": {
              "type": "string"
            },
            "title": "Retrieved",
            "type": "array"
          }
        },
        "required": [
          "question",
          "answer",
          "found",
          "rejected",
          "citations",
          "retrieved",
          "provenance",
          "elapsed_ms"
