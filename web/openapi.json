            "type": "string"
          },
          "split": {
            "anyOf": [
              {
                "enum": [
                  "train",
                  "dev",
                  "test"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Restrict retrieval to one data split",
            "title": "Split"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskIn",
        "type": "object"
